# =================================================================
# EvoSenseFleet Telematics Web API Backend Environment Configuration Example
# =================================================================

# Server Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# -----------------------------------------------------------------
# OCI MySQL HeatWave Database Configuration
# -----------------------------------------------------------------
# Set MYSQL_HOST to your OCI MySQL HeatWave Instance Private IP or Hostname.
# Example: MYSQL_HOST=10.0.1.15
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=YourSecurePassword123!
MYSQL_DATABASE=evosensefleet
MYSQL_SSL=false

# -----------------------------------------------------------------
# Local SQLite Storage Configuration (Fallback when MYSQL_HOST is empty)
# -----------------------------------------------------------------
DATABASE_PATH=./data/evosense.db
